# Generated from dnsmasq.conf.template — do not edit by hand.
# Re-run scripts/render-config.sh after changing .env.

port=53
bind-interfaces
no-resolv
no-hosts
server=${UPSTREAM_DNS_1}
server=${UPSTREAM_DNS_2}

# Authoritative locally so AAAA is not forwarded to Sony/Akamai
local=/manuals.playstation.net/
local=/manual.playstation.net/
local=/doc.dl.playstation.net/

# Send the PS5 User's Guide domains to this host
address=/manuals.playstation.net/${SERVER_IP}
address=/manual.playstation.net/${SERVER_IP}
address=/doc.dl.playstation.net/${SERVER_IP}

# Block firmware update / patch endpoints (keeps the console on its current FW)
address=/update.playstation.net/0.0.0.0
address=/update.playstation.com/0.0.0.0
address=/dservices.playstation.net/0.0.0.0
address=/fms.playstation.net/0.0.0.0
address=/pst-patch.playstation.net/0.0.0.0
address=/sonyentertainmentnetwork.com/0.0.0.0
address=/scea.com/0.0.0.0

log-queries
log-facility=-
